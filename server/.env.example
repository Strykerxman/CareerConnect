PORT=4000
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
DB_PATH=./careerconnect.db
UPLOAD_DIR=./uploads

# US-15 AI resume feedback (Google Gemini). Get a free key at https://aistudio.google.com/apikey
# Without it, the app still runs and AI feedback shows an "unavailable" message.
# GEMINI_API_KEY=your-key
# Optional: separate keys per feature (each falls back to GEMINI_API_KEY).
# Use keys from different Google Cloud projects; free-tier quota is per project.
# GEMINI_FEEDBACK_API_KEY=your-feedback-key
# GEMINI_MATCH_API_KEY=your-match-key
# Optional: override the Gemini model (default gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash
